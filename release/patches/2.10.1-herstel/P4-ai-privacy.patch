@@ -61,10 +66,10 @@ test('lokaal Ollama-endpoint: verzonden gegevens bevatten geen namen, id\'s, geb
 
 test('Ollama zonder modelnaam of onbereikbaar: terugval op regelgebaseerd',async()=>{
