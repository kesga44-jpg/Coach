diff --git a/app.js b/app.js
index 44d19c7..dd7c1cf 100644
--- a/app.js
+++ b/app.js
@@ -2059,6 +2059,91 @@ function saveAiSettingsCheck(){
   if(ep){const info=aiEndpointInfo(ep);if(!info.ok){toast('Instellingen niet opgeslagen: '+info.reason);return false}}
   return true;
 }
+/* -- Patch 4 · AI-privacy: gezondheidsinformatie filteren, exacte preview, bij twijfel niet verzenden --
+   Bovenop de pseudonimisering uit 2.10: (1) elk tekstveld met mogelijke gezondheids-/blessure-/medische informatie
+   wordt in zijn geheel weggelaten; (2) een vraag met zulke termen wordt niet verstuurd; (3) vlak vóór verzending
+   wordt het complete verzoek nogmaals gecontroleerd op namen, spelers-id's, contactgegevens en gezondheidstermen —
+   bij één treffer wordt NIETS verstuurd; (4) de trainer ziet vooraf exact de tekst die verstuurd wordt en
+   bevestigt met een aparte knop. De herkenning is een woordenlijst: conservatief, maar niet volledig (zie docs). */
+const AI_HEALTH_STEMS=/(blessure|geblesseerd|hamstring|kruisband|meniscus|achilles|hersenschudding|verrekking|verstuik|kneuzing|fractuur|ontwricht|fysio|ziekenhuis|medicat|medicijn|pijnstiller|astma|diabet|epilep|hartklacht|hartritme|hartprobleem|allergi|depressi|burn-?out|psycholo|psychiat|eetstoornis|zwanger|revalid|herstellend|spierscheur|spierpijn|liesklacht|knieklacht|rugklacht|concussion|injur|surgery|hospital|physio)/i;
+const AI_HEALTH_WORDS=/(^|[^\p{L}\p{N}])(ziek|zieke|ziekte|ziektes|griep|koorts|verkouden|covid|corona|pijn|pijnlijk|klacht|klachten|arts|huisarts|sportarts|dokter|operatie|geopereerd|gebroken|breuk|gekneusd|verrekt|verzwikt|angst|angstig|paniek|therapie|medisch|medische|lichamelijk|lichamelijke|gezondheid|sick|illness|pain|medical|doctor|ill)(?=$|[^\p{L}\p{N}])/iu;
+const AI_OMITTED='[weggelaten: mogelijk gezondheidsinformatie]';
+const AI_SYSTEM_EXTRA=' Gevoelige informatie is bewust weggelaten; ga daar niet naar raden.';
+const AI_PRIVACY_NOTE='Gepseudonimiseerd: spelers heten S1…Sn; persoonsgegevens en gevoelige gegevens zijn weggelaten.';
+function aiHealthHit(text){const t=String(text??'');const m=t.match(AI_HEALTH_STEMS)||t.match(AI_HEALTH_WORDS);return m?(m[2]||m[1]||m[0]).toLowerCase():''}
+function aiFilterHealth(ctx){
+  const removed=[];
+  const walk=(v,p)=>{
+    if(typeof v==='string'){const hit=aiHealthHit(v);if(hit){removed.push({veld:p,term:hit});return AI_OMITTED}return v}
+    if(Array.isArray(v))return v.map((x,i)=>walk(x,`${p}[${i}]`));
+    if(v&&typeof v==='object')return Object.fromEntries(Object.entries(v).map(([k,x])=>[k,k==='privacy'?x:walk(x,p?`${p}.${k}`:k)]));
+    return v;
+  };
+  return {ctx:walk(ctx,''),removed};
+}
+/* Laatste controle op de complete tekst die verstuurd zou worden. Leeg resultaat = veilig. */
+function aiFinalCheck(bodyText){
+  const issues=[],body=String(bodyText).replaceAll(AI_OMITTED,'').replaceAll(AI_SYSTEM_PROMPT,'').replaceAll(AI_SYSTEM_EXTRA,'');
+  const words=new Set();(state.players||[]).forEach(p=>[playerFullName(p),p.name,p.firstName,p.lastName].forEach(n=>{if(n&&String(n).trim().length>=3)words.add(String(n).trim())}));
+  (state.staff||[]).forEach(x=>{if(x?.name&&x.name.trim().length>=3)words.add(x.name.trim())});
+  for(const n of words){const re=new RegExp(`(^|[^\\p{L}\\p{N}])${n.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')}(?=$|[^\\p{L}\\p{N}])`,'iu');if(re.test(body)){issues.push('naam van een speler of staflid');break}}
+  if((state.players||[]).some(p=>p.id&&body.includes(p.id)))issues.push('spelers-id');
+  if(/[\w.+-]+@[\w-]+\.[\w.-]+/.test(body))issues.push('e-mailadres');
+  if(/(?:\+31|\b0)[\s-]?6[\s-]?(?:\d[\s-]?){8}\b/.test(body))issues.push('telefoonnummer');
+  if(/\b(19|20)\d{2}-\d{2}-\d{2}\b/.test(body)&&(state.players||[]).some(p=>p.birthDate&&body.includes(p.birthDate)))issues.push('geboortedatum');
+  const h=aiHealthHit(body);if(h)issues.push(`mogelijke gezondheidsinformatie (“${h}”)`);
+  return issues;
+}
+function aiBuildRequest(info,prompt){
+  const base=buildPrivateCoachSummary(prompt),filtered=aiFilterHealth(base.ctx);
+  const payload={...base,ctx:{...filtered.ctx,privacy:AI_PRIVACY_NOTE}};
+  let bodyObj;
+  if(info.kind==='ollama'){
+    if(!state.ai.model)throw new Error('Vul bij Instellingen de naam van het lokale model in (bijv. het model dat je in Ollama hebt geïnstalleerd)');
+    bodyObj={model:state.ai.model,stream:false,messages:[{role:'system',content:AI_SYSTEM_PROMPT+AI_SYSTEM_EXTRA},{role:'user',content:`${payload.prompt}\n\nContext (JSON):\n${JSON.stringify(payload.ctx,null,2)}`}]};
+  }else bodyObj={prompt:payload.prompt,context:payload.ctx};
+  return {bodyText:JSON.stringify(bodyObj,null,2),refs:base.refs,removed:filtered.removed,players:payload.ctx.players.length};
+}
+async function aiSendExact(info,bodyText){
+  const issues=aiFinalCheck(bodyText);
+  if(issues.length)throw Object.assign(new Error('Niet verstuurd: '+issues.join(', ')),{blocked:true});
+  const ctrl=typeof AbortController==='function'?new AbortController():null,timer=ctrl?setTimeout(()=>ctrl.abort(),120000):null;
+  try{
+    const r=await fetch(info.url,{method:'POST',headers:{'Content-Type':'application/json'},body:bodyText,signal:ctrl?.signal,credentials:'omit',referrerPolicy:'no-referrer'});
+    if(!r.ok)throw new Error('Endpoint gaf '+r.status);
+    const data=await r.json();
+    const text=info.kind==='ollama'?data?.message?.content:(data.answer||data.output||data.text);
+    if(typeof text!=='string'||!text.trim())throw new Error('Leeg of onbekend antwoord van het lokale model');
+    return text.slice(0,20000);
+  }finally{if(timer)clearTimeout(timer)}
+}
+runAssistant=async function(){
+  const prompt=$('#assistantPrompt')?.value.trim();if(!prompt){toast('Vul een vraag in');return}
+  ui.assistantPrompt=prompt;
+  const local=()=>{const kb=vc2PassagesText(prompt);return localAssistant(prompt)+(kb?`\n\nUit je VC2-documenten:\n${kb}`:'')};
+  const ruleBased=reason=>{ui.assistantAnswer=`Bron: regelgebaseerde coachassistent${reason?` — ${reason}`:' (lokaal, zonder AI-model)'}\n\n`+local();renderPage()};
+  if(!state.ai.endpoint)return ruleBased('');
+  const info=aiEndpointInfo(state.ai.endpoint);
+  if(!info.ok)return ruleBased(`het ingestelde AI-endpoint is niet gebruikt: ${info.reason}`);
+  const ph=aiHealthHit(prompt);
+  if(ph)return ruleBased(`niets verstuurd: je vraag bevat mogelijk gezondheidsinformatie (“${ph}”). Stel de vraag zonder medische of blessuredetails.`);
+  let req;
+  try{req=aiBuildRequest(info,prompt)}catch(e){return ruleBased('niets verstuurd: '+e.message)}
+  const pre=aiFinalCheck(req.bodyText);
+  if(pre.length)return ruleBased('niets verstuurd uit voorzorg: het verzoek bevatte nog '+pre.join(', ')+'.');
+  ui.aiPreview=req;
+  const removedHtml=req.removed.length?`<div class="callout orange" style="margin-bottom:10px"><strong>${req.removed.length} tekstveld(en) weggelaten</strong> wegens mogelijke gezondheidsinformatie:<br>${req.removed.slice(0,12).map(r=>`${esc(r.veld)} (“${esc(r.term)}”)`).join('<br>')}${req.removed.length>12?'<br>…':''}</div>`:'';
+  modal('Controleer wat naar het lokale AI-model gaat',
+    `<div class="ai-preview"><p class="muted small">Doel: <strong>${esc(info.host)}</strong>${state.ai.model?` · model <strong>${esc(state.ai.model)}</strong>`:''} · ${req.players} spelers als S1…S${req.players} · geen namen, id's, geboortedata, contact- of gezondheidsgegevens. Dit is <strong>exact</strong> de tekst die verstuurd wordt (${req.bodyText.length} tekens):</p>${removedHtml}<pre class="code-block" id="aiPreviewBody" style="max-height:50vh;overflow:auto;white-space:pre-wrap">${esc(req.bodyText)}</pre></div>`,
+    null,{saveText:`Versturen naar ${info.host}`,onSave:async()=>{
+      closeModal();
+      ui.assistantAnswer='Bezig met analyseren (lokaal model)…';renderPage();
+      try{const text=await aiSendExact(info,req.bodyText);ui.assistantAnswer=`Bron: lokaal AI-model via ${info.host}${state.ai.model?` (${state.ai.model})`:''} — controleer het advies zelf; er is niets opgeslagen.\n\n`+aiRestoreNames(text,req.refs)}
+      catch(e){ui.assistantAnswer=`${e.blocked?e.message:`Lokaal AI-model niet bereikbaar (${e.name==='AbortError'?'time-out':e.message})`}. Bron: regelgebaseerde coachassistent\n\n`+local()}
+      ui.aiPreview=null;renderPage();
+    }});
+  ui.assistantAnswer='Niets verstuurd: controleer het voorbeeld en kies “Versturen”, of annuleer.';
+};
