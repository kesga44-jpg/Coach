diff --git a/supabase/proposals/0002_coach_knowledge_owner_only.sql b/supabase/proposals/0002_coach_knowledge_owner_only.sql
new file mode 100644
index 0000000..8107213
--- /dev/null
+++ b/supabase/proposals/0002_coach_knowledge_owner_only.sql
@@ -0,0 +1,27 @@
+-- VOORSTEL — bucket coach-knowledge alleen voor de ingelogde eigenaar (R8 / PR-10).
+-- Status: NIET uitgevoerd. Vereist eerst: akkoord eigenaar, PR-9 (backend geverifieerd), PR-3 (back-up opslag)
+-- en een app-wijziging (PR-10) die uploadt naar <auth.uid()>/<id>.fckb met het access token i.p.v. de publieke sleutel.
+-- Zonder die app-wijziging breekt dit het koppelen/openen van kennisbankoriginelen in de huidige app.
+--
+-- Huidige situatie volgens de SQL die de app zelf toont (app.js knowledgeStorageSql):
+--   anon mag SELECT, INSERT en UPDATE op ALLE objecten in de bucket. Daarmee kan iedereen met de publishable key
+--   de objectnamen opvragen (list), versleutelde bestanden downloaden en bestaande bestanden overschrijven (x-upsert).
+--   Of productie exact zo is ingericht is NIET geverifieerd.
+--
+-- Bestaande bestanden staan in <sha256(namespace:secret)>/<id>.fckb. Die worden door dit voorstel NIET verplaatst
+-- of verwijderd; een overgangsscript (kopiëren naar <uid>/…, pas na controle oude map opruimen) hoort bij PR-10.
+
+update storage.buckets set public = false where id = 'coach-knowledge';
+
+drop policy if exists "coach knowledge read"   on storage.objects;
+drop policy if exists "coach knowledge insert" on storage.objects;
+drop policy if exists "coach knowledge update" on storage.objects;
+
+create policy "coach knowledge owner read" on storage.objects for select to authenticated
+  using (bucket_id = 'coach-knowledge' and (storage.foldername(name))[1] = (select auth.uid())::text);
+create policy "coach knowledge owner insert" on storage.objects for insert to authenticated
+  with check (bucket_id = 'coach-knowledge' and (storage.foldername(name))[1] = (select auth.uid())::text);
+create policy "coach knowledge owner update" on storage.objects for update to authenticated
+  using (bucket_id = 'coach-knowledge' and (storage.foldername(name))[1] = (select auth.uid())::text)
+  with check (bucket_id = 'coach-knowledge' and (storage.foldername(name))[1] = (select auth.uid())::text);
+-- Bewust GEEN delete-policy: verwijderen gebeurt alleen bewust via het dashboard.
diff --git a/supabase/reference/0001_coach_data_auth.rollback.sql b/supabase/reference/0001_coach_data_auth.rollback.sql
new file mode 100644
index 0000000..2464b21
--- /dev/null
+++ b/supabase/reference/0001_coach_data_auth.rollback.sql
@@ -0,0 +1,5 @@
+-- Rollback van de AANVULLINGEN uit 0001 (trigger en grootte-check). Tabel, gegevens en policies blijven bestaan:
+-- die horen bij de bestaande productieconfiguratie en worden nooit door een rollback verwijderd.
+drop trigger if exists coach_data_auth_guard on public.coach_data_auth;
+drop function if exists public.coach_data_auth_guard();
+alter table public.coach_data_auth drop constraint if exists coach_data_auth_payload_size;
diff --git a/supabase/reference/0001_coach_data_auth.sql b/supabase/reference/0001_coach_data_auth.sql
new file mode 100644
index 0000000..c62f1f7
--- /dev/null
+++ b/supabase/reference/0001_coach_data_auth.sql
@@ -0,0 +1,56 @@
+-- REFERENTIE — coach_data_auth zoals Coach (app.js) die verwacht en LEESMIJ.md hem beschrijft.
+-- Status: NIET uitgevoerd op productie (project ckodnfshelblddfypmmv). Of productie hiermee overeenkomt is
+-- NIET geverifieerd. Gebruik verify/verify-production.sql (alleen lezen) om te vergelijken.
+-- Deel A (tabel, RLS, rechten, 3 policies) = de gedocumenteerde bestaande configuratie.
+-- Deel B (trigger en grootte-check onderaan) = AANVULLING/voorstel, bestaat waarschijnlijk niet in productie.
+-- Idempotent en additief: maakt niets kapot als de tabel al bestaat, verwijdert geen gegevens.
+-- Uitvoeren op productie alleen na expliciet akkoord, verse back-up en hersteltest (ADR 0010, ADR 0011).
+
+create table if not exists public.coach_data_auth (
+  user_id    uuid        not null references auth.users(id) on delete cascade,
+  id         text        not null,
+  payload    jsonb       not null,
+  updated_at timestamptz not null default now(),
+  primary key (user_id, id)
+);
+
+alter table public.coach_data_auth enable row level security;
+
+-- Minimale rechten: anon niets; authenticated alleen SELECT/INSERT/UPDATE (geen DELETE, geen TRUNCATE).
+revoke all on table public.coach_data_auth from anon, authenticated;
+grant select, insert, update on table public.coach_data_auth to authenticated;
+
+do $$
+begin
+  if not exists (select 1 from pg_policies where schemaname='public' and tablename='coach_data_auth' and policyname='coach_data_auth_select_own') then
+    create policy coach_data_auth_select_own on public.coach_data_auth for select to authenticated using (user_id = (select auth.uid()));
+  end if;
+  if not exists (select 1 from pg_policies where schemaname='public' and tablename='coach_data_auth' and policyname='coach_data_auth_insert_own') then
+    create policy coach_data_auth_insert_own on public.coach_data_auth for insert to authenticated with check (user_id = (select auth.uid()));
+  end if;
+  if not exists (select 1 from pg_policies where schemaname='public' and tablename='coach_data_auth' and policyname='coach_data_auth_update_own') then
+    create policy coach_data_auth_update_own on public.coach_data_auth for update to authenticated using (user_id = (select auth.uid())) with check (user_id = (select auth.uid()));
+  end if;
+end $$;
+
+-- ===== Deel B: aanvullingen (voorstel) =====
+-- Voorkomt dat een rij via UPDATE naar een andere eigenaar of rij-id wordt verplaatst.
+create or replace function public.coach_data_auth_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if new.user_id is distinct from old.user_id or new.id is distinct from old.id then
+    raise exception 'user_id en id zijn onveranderlijk';
+  end if;
+  return new;
+end $$;
+revoke execute on function public.coach_data_auth_guard() from public, anon, authenticated;
+drop trigger if exists coach_data_auth_guard on public.coach_data_auth;
+create trigger coach_data_auth_guard before update on public.coach_data_auth for each row execute function public.coach_data_auth_guard();
+
+-- Grootte begrenzen (versleutelde payload; localStorage is in de praktijk ~5 MB). Voorkomt misbruik als opslagruimte.
+do $$
+begin
+  if not exists (select 1 from pg_constraint where conname='coach_data_auth_payload_size') then
+    alter table public.coach_data_auth add constraint coach_data_auth_payload_size check (pg_column_size(payload) <= 10485760) not valid;
+  end if;
+end $$;
diff --git a/supabase/tests/00_supabase_stub.sql b/supabase/tests/00_supabase_stub.sql
new file mode 100644
index 0000000..dcc5a4f
--- /dev/null
+++ b/supabase/tests/00_supabase_stub.sql
@@ -0,0 +1,25 @@
+-- Minimale nabootsing van de Supabase-omgeving voor LOKALE tests (geen echte Supabase).
+-- Rollen anon/authenticated, auth.users, auth.uid() via request.jwt.claim.sub, storage.buckets/objects en storage.foldername.
+do $$ begin
+  if not exists (select 1 from pg_roles where rolname='anon') then create role anon nologin; end if;
+  if not exists (select 1 from pg_roles where rolname='authenticated') then create role authenticated nologin; end if;
+end $$;
+create schema if not exists auth;
+create table if not exists auth.users(id uuid primary key);
+create or replace function auth.uid() returns uuid language sql stable as $$
+  select nullif(current_setting('request.jwt.claim.sub', true), '')::uuid $$;
+grant usage on schema auth to anon, authenticated;
+grant execute on function auth.uid() to anon, authenticated;
+grant usage on schema public to anon, authenticated;
+
+create schema if not exists storage;
+create table if not exists storage.buckets(id text primary key, name text, public boolean default false, file_size_limit bigint, allowed_mime_types text[]);
+create table if not exists storage.objects(id uuid primary key default gen_random_uuid(), bucket_id text references storage.buckets(id), name text not null, owner uuid, metadata jsonb, unique(bucket_id,name));
+create or replace function storage.foldername(name text) returns text[] language sql immutable as $$
+  select (string_to_array(name,'/'))[1:array_length(string_to_array(name,'/'),1)-1] $$;
+alter table storage.objects enable row level security;
+grant usage on schema storage to anon, authenticated;
+grant select, insert, update on storage.objects to anon, authenticated;  -- zoals Supabase: rechten via RLS-policies
+grant execute on function storage.foldername(text) to anon, authenticated;
+insert into storage.buckets(id,name,public) values ('coach-knowledge','coach-knowledge',false) on conflict do nothing;
+insert into auth.users values ('11111111-1111-1111-1111-111111111111'),('22222222-2222-2222-2222-222222222222') on conflict do nothing;
diff --git a/supabase/tests/10_coach_data_auth.test.sql b/supabase/tests/10_coach_data_auth.test.sql
new file mode 100644
index 0000000..8705699
--- /dev/null
+++ b/supabase/tests/10_coach_data_auth.test.sql
@@ -0,0 +1,61 @@
+-- RLS-tests coach_data_auth: eigenaar mag, ander niet, anon niets. Faalt met een exception bij een fout.
+\set ON_ERROR_STOP on
+create or replace function pg_temp.as_user(u text) returns void language plpgsql as $$
+begin
+  if u is null then perform set_config('role','anon',true); perform set_config('request.jwt.claim.sub','',true);
+  else perform set_config('role','authenticated',true); perform set_config('request.jwt.claim.sub',u,true); end if;
+end $$;
+
+begin;
+select pg_temp.as_user('11111111-1111-1111-1111-111111111111');
+insert into public.coach_data_auth(user_id,id,payload) values ('11111111-1111-1111-1111-111111111111','football-coach-v2','{"v":1}');
+do $$ begin
+  if (select count(*) from public.coach_data_auth)<>1 then raise exception 'FOUT: eigenaar ziet eigen rij niet'; end if;
+  begin
+    insert into public.coach_data_auth(user_id,id,payload) values ('22222222-2222-2222-2222-222222222222','football-coach-v2','{}');
+    raise exception 'FOUT: insert voor ander account toegestaan';
+  exception when insufficient_privilege then null; end;
+  begin delete from public.coach_data_auth; raise exception 'FOUT: delete toegestaan';
+  exception when insufficient_privilege then null; end;
+  begin update public.coach_data_auth set user_id='22222222-2222-2222-2222-222222222222';
+    raise exception 'FOUT: eigenaar wijzigen toegestaan';
+  exception when insufficient_privilege or raise_exception then
+    if sqlerrm like 'FOUT:%' then raise; end if; end;
+end $$;
+commit;
+
+begin;
+select pg_temp.as_user('22222222-2222-2222-2222-222222222222');
+do $$ begin
+  if (select count(*) from public.coach_data_auth)<>0 then raise exception 'FOUT: ander account ziet rij van eigenaar'; end if;
+  update public.coach_data_auth set payload='{"x":1}';
+end $$;
+commit;
+select count(*) filter (where payload='{"x":1}') = 0 as ander_kon_niet_wijzigen from public.coach_data_auth \gset
+\if :ander_kon_niet_wijzigen
+\else
+  \echo 'FOUT: ander account kon rij wijzigen' \q
+\endif
+
+begin;
+select pg_temp.as_user(null);
+do $$ begin
+  begin perform 1 from public.coach_data_auth; raise exception 'FOUT: anon kan lezen';
+  exception when insufficient_privilege then null; end;
+  begin insert into public.coach_data_auth(user_id,id,payload) values ('11111111-1111-1111-1111-111111111111','x','{}'); raise exception 'FOUT: anon kan schrijven';
+  exception when insufficient_privilege then null; end;
+end $$;
+commit;
+
+begin;
+select pg_temp.as_user('11111111-1111-1111-1111-111111111111');
+-- optimistische conflictcontrole zoals de app: update met updated_at-filter op oude waarde raakt 0 rijen
+do $$ declare n int; old timestamptz; begin
+  select updated_at into old from public.coach_data_auth;
+  update public.coach_data_auth set payload='{"v":2}', updated_at=old+interval '1 second' where updated_at=old;
+  get diagnostics n=row_count; if n<>1 then raise exception 'FOUT: eerste update moet slagen'; end if;
+  update public.coach_data_auth set payload='{"v":3}', updated_at=old+interval '2 second' where updated_at=old;
+  get diagnostics n=row_count; if n<>0 then raise exception 'FOUT: verouderde update mag niets raken'; end if;
+end $$;
+commit;
+\echo 'OK coach_data_auth: eigenaar/ander/anon/conflictcontrole'
diff --git a/supabase/tests/20_storage_current.test.sql b/supabase/tests/20_storage_current.test.sql
