+++ b/supabase/tests/30_storage_proposal.test.sql
@@ -0,0 +1,34 @@
+-- Test van voorstel 0002 (na toepassen): alleen de ingelogde eigenaar in de eigen map.
+\set ON_ERROR_STOP on
+insert into storage.objects(bucket_id,name) values ('coach-knowledge','11111111-1111-1111-1111-111111111111/pvb1.fckb') on conflict do nothing;
+begin;
+set local role anon;
+do $$ declare n int; begin
+  select count(*) into n from storage.objects where bucket_id='coach-knowledge';
+  if n<>0 then raise exception 'FOUT: anon ziet nog objecten'; end if;
+  begin insert into storage.objects(bucket_id,name) values ('coach-knowledge','x/y.fckb'); raise exception 'FOUT: anon kan uploaden';
+  exception when insufficient_privilege then null; end;
+  update storage.objects set metadata='{}' where bucket_id='coach-knowledge';
+  get diagnostics n=row_count; if n<>0 then raise exception 'FOUT: anon kan overschrijven'; end if;
+end $$;
+commit;
+begin;
+select set_config('role','authenticated',true), set_config('request.jwt.claim.sub','22222222-2222-2222-2222-222222222222',true);
+do $$ declare n int; begin
+  select count(*) into n from storage.objects where bucket_id='coach-knowledge';
+  if n<>0 then raise exception 'FOUT: ander account ziet bestanden van eigenaar'; end if;
+  begin insert into storage.objects(bucket_id,name) values ('coach-knowledge','11111111-1111-1111-1111-111111111111/inbraak.fckb'); raise exception 'FOUT: schrijven in map van ander';
+  exception when insufficient_privilege then null; end;
+  insert into storage.objects(bucket_id,name) values ('coach-knowledge','22222222-2222-2222-2222-222222222222/eigen.fckb');
+end $$;
+commit;
+begin;
+select set_config('role','authenticated',true), set_config('request.jwt.claim.sub','11111111-1111-1111-1111-111111111111',true);
+do $$ declare n int; begin
+  select count(*) into n from storage.objects where bucket_id='coach-knowledge';
+  if n<>1 then raise exception 'FOUT: eigenaar ziet precies zijn eigen bestand niet (%)', n; end if;
+  update storage.objects set metadata='{"size":5}' where name='11111111-1111-1111-1111-111111111111/pvb1.fckb';
+  get diagnostics n=row_count; if n<>1 then raise exception 'FOUT: eigenaar kan eigen bestand niet vervangen'; end if;
+end $$;
+commit;
+\echo 'OK voorstel 0002: anon niets, ander account niets, eigenaar alleen eigen map'
diff --git a/supabase/tests/run-local.sh b/supabase/tests/run-local.sh
new file mode 100755
index 0000000..178a9d4
--- /dev/null
+++ b/supabase/tests/run-local.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# Draait de SQL-tests tegen een TIJDELIJKE lokale PostgreSQL-cluster (geen Supabase, geen netwerk).
+# Een geslaagde lokale test bewijst NIET dat productie veilig is; zie supabase/verify/verify-production.sql.
+set -euo pipefail
+HERE="$(cd "$(dirname "$0")" && pwd)"; ROOT="$(cd "$HERE/.." && pwd)"
+PGBIN="${PGBIN:-$(ls -d /usr/lib/postgresql/*/bin 2>/dev/null | sort -V | tail -1)}"
+[ -x "$PGBIN/initdb" ] || PGBIN="$(dirname "$(command -v initdb || echo /nonexistent)")"
+if [ ! -x "$PGBIN/initdb" ]; then echo "OVERGESLAGEN: PostgreSQL (initdb) niet gevonden"; exit 0; fi
+TMP="$(mktemp -d)"; PORT="${PGPORT_TEST:-54329}"
+RUN=(); if [ "$(id -u)" = "0" ]; then chown -R postgres "$TMP"; RUN=(runuser -u postgres --); fi
+cleanup(){ "${RUN[@]}" "$PGBIN/pg_ctl" -D "$TMP/data" -m fast stop >/dev/null 2>&1 || true; rm -rf "$TMP"; }
+trap cleanup EXIT
+"${RUN[@]}" "$PGBIN/initdb" -D "$TMP/data" -A trust -U coachtest >/dev/null
+"${RUN[@]}" "$PGBIN/pg_ctl" -D "$TMP/data" -o "-p $PORT -k $TMP -c listen_addresses=''" -l "$TMP/log" -w start >/dev/null
+PSQL=("${RUN[@]}" "$PGBIN/psql" -h "$TMP" -p "$PORT" -U coachtest -d postgres -v ON_ERROR_STOP=1 -q)
+run(){ echo "== $1"; "${PSQL[@]}" -f "$1"; }
+run "$HERE/00_supabase_stub.sql"
+run "$ROOT/reference/0001_coach_data_auth.sql"
+run "$ROOT/reference/0001_coach_data_auth.sql"   # idempotentie
+run "$HERE/10_coach_data_auth.test.sql"
+run "$ROOT/reference/0001_coach_data_auth.rollback.sql"
+run "$ROOT/reference/0001_coach_data_auth.sql"
+run "$HERE/20_storage_current.test.sql"
+run "$ROOT/proposals/0002_coach_knowledge_owner_only.sql"
+run "$HERE/30_storage_proposal.test.sql"
+run "$ROOT/proposals/0002_coach_knowledge_owner_only.rollback.sql"
+run "$ROOT/proposals/0002_coach_knowledge_owner_only.sql"
+echo "ALLE LOKALE SQL-TESTS GESLAAGD (lokaal aangetoond, niet productiegeverifieerd)"
diff --git a/supabase/verify/verify-production.sql b/supabase/verify/verify-production.sql
new file mode 100644
index 0000000..893a790
--- /dev/null
+++ b/supabase/verify/verify-production.sql
@@ -0,0 +1,37 @@
+-- ALLEEN LEZEN. Uitvoeren in het Supabase-dashboard (SQL Editor) van project ckodnfshelblddfypmmv.
+-- Wijzigt niets. Plak de uitkomst in docs/SUPABASE.md § Productieverificatie (zonder gegevensinhoud).
+
+-- 1. Bestaat de tabel en staat RLS aan (en geforceerd)?
+select c.relname, c.relrowsecurity as rls_aan, c.relforcerowsecurity as rls_geforceerd
+from pg_class c join pg_namespace n on n.oid=c.relnamespace
+where n.nspname='public' and c.relname in ('coach_data_auth','coach_data');
+
+-- 2. Kolommen en primaire sleutel
+select column_name, data_type, is_nullable from information_schema.columns
+where table_schema='public' and table_name='coach_data_auth' order by ordinal_position;
+select conname, pg_get_constraintdef(oid) from pg_constraint where conrelid='public.coach_data_auth'::regclass;
+
+-- 3. Policies (verwacht: 3 voor authenticated, alle met user_id = auth.uid(); geen anon, geen delete)
+select policyname, cmd, roles, qual, with_check from pg_policies
+where schemaname='public' and tablename in ('coach_data_auth','coach_data') order by tablename, policyname;
+
+-- 4. Tabelrechten (verwacht: anon geen; authenticated alleen SELECT/INSERT/UPDATE)
+select grantee, table_name, string_agg(privilege_type, ', ' order by privilege_type) as rechten
+from information_schema.role_table_grants
+where table_schema='public' and table_name in ('coach_data_auth','coach_data') and grantee in ('anon','authenticated','public')
+group by grantee, table_name order by table_name, grantee;
+
+-- 5. Storage-buckets (publiek of privé; limieten)
+select id, public, file_size_limit, allowed_mime_types from storage.buckets where id in ('coach-knowledge','vc2');
+
+-- 6. Storage-policies die de buckets raken
+select policyname, cmd, roles, qual, with_check from pg_policies
+where schemaname='storage' and tablename='objects'
+  and (coalesce(qual,'') ilike '%coach-knowledge%' or coalesce(with_check,'') ilike '%coach-knowledge%'
+    or coalesce(qual,'') ilike '%vc2%' or coalesce(with_check,'') ilike '%vc2%' or roles::text ilike '%anon%')
+order by policyname;
+
+-- 7. Aantallen (geen inhoud): objecten per bucket en per eerste map
+select bucket_id, (storage.foldername(name))[1] as map, count(*) as bestanden, sum((metadata->>'size')::bigint) as bytes
+from storage.objects where bucket_id in ('coach-knowledge','vc2') group by 1,2 order by 1,2;
+select count(*) as rijen, count(distinct user_id) as gebruikers, max(updated_at) as laatst_gewijzigd from public.coach_data_auth;
