+/* ==== Coach main 2.10.0 — uitbreidingen (vóór het registreren van de klikhandler) ==== */
+/* -- 2.10 · Back-up en herstel inclusief Kennis & Ontwikkeling --
+   Formaat: de bestaande state-JSON blijft de basis (oudere app-versies kunnen het bestand dus nog lezen).
+   Nieuw zijn twee optionele velden: backupMeta (herkenning/versie) en knowledgeModule (Kennis-export, zelfde
+   formaat als "Kennis exporteren"). Herstel vervangt de teamgegevens zoals voorheen, maar:
+   - Kennis & Ontwikkeling wordt alleen AANGEVULD (dubbelen worden overgeslagen), nooit overschreven of verwijderd;
+   - koppelingen naar versleutelde kennisbankoriginelen (knowledgeFiles) die lokaal bekend zijn blijven behouden. */
+const APP_VERSION='2.10.0';
+const BACKUP_FORMAT='football_coach_backup';
+const BACKUP_FORMAT_VERSION=2;
+const BACKUP_MAX_BYTES=25*1024*1024;
+function mergeKnowledgeFiles(current,incoming){
+  const out={};
+  const put=(id,meta)=>{if(!meta||typeof meta!=='object'||Array.isArray(meta))return;const prev=out[id];if(!prev||String(meta.uploadedAt||'')>String(prev.uploadedAt||''))out[id]=clone(meta)};
+  Object.entries(current||{}).forEach(([id,m])=>put(id,m));
+  Object.entries(incoming||{}).forEach(([id,m])=>put(id,m));
+  return out;
+}
+function buildFullBackup(){
+  const data=clone(state);
+  delete data.backupMeta;delete data.knowledgeModule;
+  data.backupMeta={format:BACKUP_FORMAT,version:BACKUP_FORMAT_VERSION,appVersion:APP_VERSION,exportedAt:new Date().toISOString(),contains:['teamgegevens','knowledgeFiles (alleen koppelingen)']};
+  const kd=typeof kdRead==='function'?kdRead():null;
+  if(kd&&!kd.error){data.knowledgeModule=kdExportPayload(kd.store);data.backupMeta.contains.push('Kennis & Ontwikkeling')}
+  else if(kd&&kd.error)data.backupMeta.knowledgeModuleError=kd.error;
+  return data;
+}
+/* Zuivere functie: bepaalt wat een herstel zou doen, zonder iets op te slaan. Gooit een fout bij ongeldige invoer. */
+function backupRestorePlan(raw,current=state,kdStore=null){
+  if(raw&&typeof raw==='object'&&!Array.isArray(raw)&&raw.format===KD_EXPORT_FORMAT)throw new Error('Dit is een Kennis-export. Importeer die via Meer → Kennis & Ontwikkeling → Importeren.');
+  if(!raw||typeof raw!=='object'||Array.isArray(raw))throw new Error('Back-up moet een JSON-object zijn');
+  const {backupMeta,knowledgeModule,...rest}=raw;
+  const data=validateStateData(clone(rest));
+  const warnings=[];
+  const meta=backupMeta&&typeof backupMeta==='object'&&!Array.isArray(backupMeta)?backupMeta:null;
+  if(meta&&meta.format===BACKUP_FORMAT&&Number(meta.version)>BACKUP_FORMAT_VERSION)warnings.push(`Deze back-up komt uit een nieuwere app-versie (${meta.appVersion||'onbekend'}); onbekende onderdelen worden bewaard maar mogelijk niet gebruikt.`);
+  data.knowledgeFiles=mergeKnowledgeFiles(current?.knowledgeFiles,data.knowledgeFiles);
+  let knowledge=null,knowledgeSummary={updates:0,items:0,newItems:0,duplicates:0,error:''};
+  if(knowledgeModule!==undefined){
+    if(!knowledgeModule||typeof knowledgeModule!=='object'||knowledgeModule.format!==KD_EXPORT_FORMAT||!Array.isArray(knowledgeModule.updates)){knowledgeSummary.error='Het kennisonderdeel van deze back-up is ongeldig en wordt overgeslagen.'}
+    else{
+      knowledge=knowledgeModule;
+      knowledgeSummary.updates=knowledgeModule.updates.length;
+      knowledgeSummary.items=knowledgeModule.updates.reduce((n,u)=>n+(Array.isArray(u?.items)?u.items.length:0),0);
+      if(kdStore){const p=kdParse(JSON.stringify(knowledgeModule),kdStore);if(p.ok){knowledgeSummary.newItems=p.newItems.length;knowledgeSummary.duplicates=p.duplicates.length}else knowledgeSummary.error=p.errors[0]||'Kennisonderdeel kan niet worden gelezen'}
+    }
+  }
+  if(knowledgeSummary.error)warnings.push(knowledgeSummary.error);
+  const count=k=>Array.isArray(data[k])?data[k].length:0;
+  return {data,knowledge,legacy:!meta,meta,warnings,knowledgeSummary,
+    summary:{players:count('players'),trainings:count('trainings'),matches:count('matches'),exercises:count('exercises'),teams:count('teams'),linkedKnowledgeFiles:Object.keys(data.knowledgeFiles||{}).length}};
+}
+function backupConfirmText(plan){
+  const s=plan.summary,k=plan.knowledgeSummary;
+  const lines=[
+    `Back-up ${plan.legacy?'(ouder formaat, zonder kennisonderdeel)':`van ${plan.meta?.exportedAt?new Date(plan.meta.exportedAt).toLocaleString('nl-NL'):'onbekende datum'} (app ${plan.meta?.appVersion||'?'})`}`,
+    `Bevat: ${s.teams} team(s), ${s.players} spelers, ${s.trainings} trainingen, ${s.matches} wedstrijden, ${s.exercises} oefeningen.`,
+    '',
+    'Deze teamgegevens VERVANGEN de huidige lokale teamgegevens. De huidige versie wordt eerst als herstelpunt bewaard.',
+    `Gekoppelde kennisbankoriginelen blijven behouden (${s.linkedKnowledgeFiles} koppeling(en) na herstel).`,
+    plan.knowledge?`Kennis & Ontwikkeling wordt AANGEVULD: ${k.newItems} nieuw, ${k.duplicates} al aanwezig. Bestaande kennis wordt nooit overschreven of verwijderd.`:'Kennis & Ontwikkeling blijft ongewijzigd.'
+  ];
+  if(plan.warnings.length)lines.push('','Let op: '+plan.warnings.join(' '));
+  lines.push('','Doorgaan?');
+  return lines.join('\n');
+}
+exportBackup=function(){
+  if(storageLoadError){toast('Back-up niet gemaakt: herstel eerst de ongeldige bestaande opslag');return false}
+  try{
+    state.meta.lastManualBackupAt=new Date().toISOString();
+    localStorage.setItem(STORAGE_KEY,JSON.stringify(state));
+    const data=buildFullBackup();
+    downloadJson(data,`football-coach-backup-${TODAY()}.json`);
+    renderPage();
+    const n=data.knowledgeModule?data.knowledgeModule.updates.reduce((a,u)=>a+u.items.length,0):0;
+    toast(data.backupMeta.knowledgeModuleError?'Back-up gedownload, maar ZONDER kennis: '+data.backupMeta.knowledgeModuleError:`Back-up gedownload (inclusief ${n} kennisartikel${n===1?'':'en'})`);
+    return data;
+  }catch(e){toast('Back-up maken mislukt: '+e.message);return false}
+};
+importBackup=async function(file){
+  const previousState=state,previousTeamId=ui.teamId;
+  let plan;
+  try{
+    if(file&&file.size>BACKUP_MAX_BYTES)throw new Error('bestand is groter dan 25 MB');
+    let raw;try{raw=JSON.parse(await file.text())}catch{throw new Error('bestand is geen geldige JSON')}
+    const kd=kdRead();
+    plan=backupRestorePlan(raw,state,kd.error?null:kd.store);
+    if(kd.error&&plan.knowledge){plan.warnings.push('Opgeslagen kennisgegevens zijn onleesbaar; het kennisonderdeel wordt overgeslagen.');plan.knowledge=null}
+  }catch(e){toast(`Back-up niet toegepast: ${e.message||'bestand kan niet worden gelezen'}`);return {ok:false,error:e.message}}
+  if(!confirm(backupConfirmText(plan)))return {ok:false,cancelled:true};
+  try{
+    const previousRaw=localStorage.getItem(STORAGE_KEY)??localStorage.getItem(LEGACY_STORAGE_KEY);
+    state=clone(plan.data);
+    normalize();
+    state.meta.updatedAt=new Date().toISOString();
+    state.meta.lastRestoreAt=state.meta.updatedAt;
+    const serialized=JSON.stringify(state);
+    localStorage.setItem(RECOVERY_BACKUP_KEY,JSON.stringify({at:new Date().toISOString(),raw:previousRaw??JSON.stringify(previousState),state:storageLoadError?null:clone(previousState)}));
+    localStorage.setItem(STORAGE_KEY,serialized);
+    storageLoadError=null;freshInstall=false;
+    if(typeof clearSyncBase==='function')clearSyncBase();
+  }catch(e){
+    state=previousState;ui.teamId=previousTeamId;
+    toast(`Back-up niet toegepast: ${e.message||'opslaan mislukt'}; bestaande gegevens zijn behouden`);
+    return {ok:false,error:e.message};
+  }
+  let kdResult=null,msg='Back-up gevalideerd en hersteld';
+  if(plan.knowledge){
+    kdResult=kdImport(JSON.stringify(plan.knowledge));
+    msg+=kdResult.ok?` · kennis: ${kdResult.added} toegevoegd, ${kdResult.duplicates} al aanwezig`:` · kennis NIET aangevuld (${(kdResult.errors||[])[0]||'onbekende fout'}); teamgegevens zijn wel hersteld`;
+  }
+  renderPage();toast(msg);
+  return {ok:true,knowledge:kdResult,summary:plan.summary};
+};
+/* @@2.10-SECTIONS@@ */
 document.addEventListener('click',handleClick);
 $('#quickAdd').onclick=()=>{if(ui.page==='players')editPlayer();else if(ui.page==='matches')editMatch();else if(ui.page==='exercises')editExercise();else if(ui.page==='notes')editNote();else if(ui.page==='tactics')editTactic();else openTrainingTemplateChooser()};
 $('#importFile').onchange=e=>{const f=e.target.files[0];if(f)importBackup(f);e.target.value=''};
