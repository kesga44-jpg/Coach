+/* -- 2.10 · Coachassistent: privacy (risico R9) en optionele lokale AI (ADR 0008) --
+   1. Regelgebaseerd blijft de standaard en werkt altijd zonder model.
+   2. Een AI-endpoint mag alleen een LOKAAL adres zijn (dit apparaat of het eigen netwerk), bijv. Ollama.
+      Externe/betaalde AI-diensten worden geweigerd; een eerder opgeslagen extern adres blijft bewaard maar wordt niet gebruikt.
+   3. Er gaan nooit namen, spelers-ID's, geboortedata, e-mail of blessuredetails mee: spelers worden S1…Sn,
+      vrije tekst wordt op spelersnamen geschoond. De trainer bevestigt elke verzending handmatig.
+   4. Het antwoord vermeldt altijd de bron (regelgebaseerd of lokaal model) en wordt niet automatisch opgeslagen. */
+const AI_PRIVATE_HOST_RE=/^(localhost|127(?:\.\d{1,3}){3}|\[::1\]|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2}|[a-z0-9-]+\.local|[a-z0-9.-]+\.localhost)$/i;
+function aiEndpointInfo(url){
+  const raw=String(url||'').trim();
+  if(!raw)return {ok:false,empty:true,reason:'Geen endpoint ingesteld'};
+  let u;try{u=new URL(raw)}catch{return {ok:false,reason:'Ongeldig adres'}}
+  if(!/^https?:$/.test(u.protocol))return {ok:false,reason:'Alleen http(s)-adressen'};
+  if(u.username||u.password)return {ok:false,reason:'Geen inloggegevens in het adres'};
+  if(!AI_PRIVATE_HOST_RE.test(u.hostname))return {ok:false,reason:`${u.hostname} is geen lokaal adres. Alleen AI op dit apparaat of het eigen netwerk is toegestaan (bijv. http://localhost:11434/api/chat voor Ollama).`};
+  return {ok:true,host:u.host,kind:/\/api\/chat\/?$/.test(u.pathname)?'ollama':'json',url:u.href};
+}
+function aiNameTokens(players){
+  const out=[];
+  players.forEach((p,i)=>{
+    const ref='S'+(i+1),full=playerFullName(p);
+    [full,p.name,[p.lastName,p.firstName].filter(Boolean).join(' ')].filter(x=>x&&x.trim().length>=3).forEach(n=>out.push([n.trim(),ref]));
+    [p.firstName,p.lastName].filter(x=>x&&x.trim().length>=3).forEach(n=>out.push([n.trim(),ref]));
+  });
+  return out.sort((a,b)=>b[0].length-a[0].length);
+}
+function aiScrub(text,tokens){
+  let t=String(text??'');
+  tokens.forEach(([name,ref])=>{const re=new RegExp(`(^|[^\\p{L}\\p{N}])${name.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')}(?=$|[^\\p{L}\\p{N}])`,'giu');t=t.replace(re,(m,pre)=>pre+ref)});
+  t=t.replace(/[\w.+-]+@[\w-]+\.[\w.-]+/g,'[e-mail]').replace(/\b(?:\+31|0)[\s-]?6[\s-]?(?:\d[\s-]?){8}\b/g,'[telefoon]');
+  return t;
+}
+function buildPrivateCoachSummary(prompt){
+  const team=activeTeam(),players=playersForTeam(team.id),tokens=aiNameTokens(players),scrub=x=>aiScrub(x,tokens),refOf=new Map(players.map((p,i)=>[p.id,'S'+(i+1)]));
+  const tr=t=>t?{date:t.date,focus:scrub(t.focus||t.title||''),objective:scrub(t.trainingObjective||''),intensity:t.intensity||'',onderdelen:(t.planItems||[]).map(pi=>{const ex=exerciseById(pi.exerciseId);return {oefening:ex?scrub(ex.name):'',minuten:number(pi.duration)}})}:null;
+  const m=x=>x?{date:x.date,opponent:x.opponent||'',formation:x.formation||'',competition:x.competition||''}:null;
+  const ctx={
+    privacy:'Gepseudonimiseerd: spelers heten S1…Sn; geen namen, geboortedata, contactgegevens of blessuredetails.',
+    team:{formation:team.formation||'',spelers:players.length},
+    players:players.map(p=>({ref:refOf.get(p.id),position:p.position||'',selection:p.selection||'',trainingsopkomstPct:attendancePct(p.id,team.id),wedstrijden:(({games,starts,minutes,goals,assists})=>({games,starts,minutes,goals,assists}))(matchTotals(p.id,team.id)),ontwikkeldoel:scrub(p.developmentGoals||'')})),
+    volgendeTraining:tr(nextTraining(team.id)),
+    volgendeWedstrijd:m(nextMatch(team.id)),
+    recenteWedstrijden:state.matches.filter(x=>x.teamId===team.id&&!isCancelled(x)&&x.date<=TODAY()).sort((a,b)=>b.date.localeCompare(a.date)).slice(0,5).map(x=>({...m(x),score:[x.goalsFor,x.goalsAgainst],goed:scrub(x.evaluation?.good||''),verbeter:scrub(x.evaluation?.improve||''),volgendeTraining:scrub(x.evaluation?.nextTraining||''),plan:Object.fromEntries(Object.entries(x.plan||{}).map(([k,v])=>[k,scrub(v)]))})),
+    notities:state.coachNotes.filter(n=>n.teamId===team.id&&!n.playerId&&['Algemeen','Training','Wedstrijd','Tactiek'].includes(n.category)).slice(-10).map(n=>`${n.category}: ${scrub(n.text||'')}`),
+    kennisbank:vc2Passages(prompt,5).map(p=>({bron:p.name,pagina:p.page||null,tekst:scrub(p.text)}))
+  };
+  return {ctx,refs:players.map((p,i)=>['S'+(i+1),playerFullName(p)]),prompt:scrub(prompt)};
+}
+function aiRestoreNames(answer,refs){
+  const map=new Map(refs);
+  return String(answer??'').replace(/\bS(\d{1,3})\b/g,(m)=>map.has(m)?`${map.get(m)} (${m})`:m);
+}
+const AI_SYSTEM_PROMPT='Je bent een assistent voor een amateurvoetbaltrainer. Antwoord in het Nederlands, kort en praktisch. Gebruik alleen de meegegeven context; verzin geen gegevens. Spelers heten S1, S2 enz. Geef geen medisch advies.';
+async function callLocalAi(info,payload){
+  let body;
+  if(info.kind==='ollama'){
+    if(!state.ai.model)throw new Error('Vul bij Instellingen de naam van het lokale model in (bijv. het model dat je in Ollama hebt geïnstalleerd)');
+    body={model:state.ai.model,stream:false,messages:[{role:'system',content:AI_SYSTEM_PROMPT},{role:'user',content:`${payload.prompt}\n\nContext (JSON):\n${JSON.stringify(payload.ctx)}`}]};
+  }else body={prompt:payload.prompt,context:payload.ctx};
+  const ctrl=typeof AbortController==='function'?new AbortController():null,timer=ctrl?setTimeout(()=>ctrl.abort(),120000):null;
+  try{
+    const r=await fetch(info.url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body),signal:ctrl?.signal,credentials:'omit',referrerPolicy:'no-referrer'});
+    if(!r.ok)throw new Error('Endpoint gaf '+r.status);
+    const data=await r.json();
+    const text=info.kind==='ollama'?data?.message?.content:(data.answer||data.output||data.text);
+    if(typeof text!=='string'||!text.trim())throw new Error('Leeg of onbekend antwoord van het lokale model');
+    return text.slice(0,20000);
+  }finally{if(timer)clearTimeout(timer)}
+}
+runAssistant=async function(){
+  const prompt=$('#assistantPrompt')?.value.trim();if(!prompt){toast('Vul een vraag in');return}
+  ui.assistantPrompt=prompt;
+  const local=()=>{const kb=vc2PassagesText(prompt);return localAssistant(prompt)+(kb?`\n\nUit je VC2-documenten:\n${kb}`:'')};
+  const info=aiEndpointInfo(state.ai.endpoint);
+  if(!state.ai.endpoint){ui.assistantAnswer='Bron: regelgebaseerde coachassistent (lokaal, zonder AI-model)\n\n'+local();renderPage();return}
+  if(!info.ok){ui.assistantAnswer=`Bron: regelgebaseerde coachassistent — het ingestelde AI-endpoint is niet gebruikt: ${info.reason}\n\n`+local();renderPage();return}
+  const payload=buildPrivateCoachSummary(prompt);
+  if(!confirm(`Je vraag en een gepseudonimiseerde teamsamenvatting (${payload.ctx.players.length} spelers als S1…S${payload.ctx.players.length}; geen namen, geboortedata, contact- of blessuregegevens) worden verstuurd naar het lokale AI-endpoint ${info.host}. Doorgaan?`)){ui.assistantAnswer='Niets verstuurd. Bron: regelgebaseerde coachassistent\n\n'+local();renderPage();return}
+  ui.assistantAnswer='Bezig met analyseren (lokaal model)…';renderPage();
+  try{const text=await callLocalAi(info,payload);ui.assistantAnswer=`Bron: lokaal AI-model via ${info.host}${state.ai.model?` (${state.ai.model})`:''} — controleer het advies zelf; er is niets opgeslagen.\n\n`+aiRestoreNames(text,payload.refs)}
+  catch(e){ui.assistantAnswer=`Lokaal AI-model niet bereikbaar (${e.name==='AbortError'?'time-out':e.message}). Bron: regelgebaseerde coachassistent\n\n`+local()}
+  renderPage();
+};
+const renderAssistantBase210=renderAssistant;
+renderAssistant=function(){
+  const info=aiEndpointInfo(state.ai.endpoint);
+  return renderAssistantBase210()
+    .replace('Een echte AI-koppeling kan via een beveiligde server/edge-function. Zet nooit een geheime API-sleutel rechtstreeks in deze GitHub Pages-code.',
+      state.ai.endpoint&&!info.ok?`Ingesteld AI-endpoint wordt niet gebruikt: ${esc(info.reason)}`:'Standaard regelgebaseerd. Optioneel een lokaal model (bijv. Ollama op dit apparaat); je bevestigt elke verzending en namen worden vervangen door S1…Sn.')
+    .replace(`>${state.ai.endpoint?'Endpoint':'Lokaal'}</span>`,`>${state.ai.endpoint&&info.ok?'Lokaal model':'Regelgebaseerd'}</span>`);
+};
+const renderSettingsBase210=renderSettings;
+renderSettings=function(){
+  return renderSettingsBase210()
+    .replace('<label>Beveiligde AI-endpoint (optioneel)</label><input id="setAiEndpoint" class="input" placeholder="https://.../coach-ai"',
+      '<label>Lokaal AI-endpoint (optioneel)</label><input id="setAiEndpoint" class="input" inputmode="url" placeholder="http://localhost:11434/api/chat"')
+    .replace(/(<input id="setAiEndpoint"[^>]*>)<\/div>/,`$1<small class="muted tiny">Alleen lokaal (dit apparaat of eigen netwerk). Geen externe of betaalde AI-diensten.</small></div><div class="field full"><label>Lokaal model (Ollama)</label><input id="setAiModel" class="input" placeholder="naam van het geïnstalleerde model" value="${esc(state.ai.model||'')}"></div>`);
+};
+function saveAiSettingsCheck(){
+  const ep=$('#setAiEndpoint')?.value.trim()||'';
+  if(ep){const info=aiEndpointInfo(ep);if(!info.ok){toast('Instellingen niet opgeslagen: '+info.reason);return false}}
+  return true;
+}
+/* -- 2.10 · Kennisbank-opslag: eerlijke waarschuwing bij de getoonde SQL (zie docs/SUPABASE.md en docs/SECURITY.md) -- */
+const renderKnowledgeBase210=renderKnowledge;
+renderKnowledge=function(){
+  return renderKnowledgeBase210().replace('<pre class="code-block">',`<div class="callout red" role="note" style="margin-bottom:10px"><strong>Beveiligingswaarschuwing.</strong> Met deze policies kan iedereen met de publieke (publishable) sleutel bestanden in de bucket <code>${esc(KNOWLEDGE_BUCKET)}</code> opvragen, toevoegen en <strong>overschrijven</strong>. De inhoud blijft versleuteld, maar kan wel worden vervangen of onbruikbaar gemaakt. Bewaar daarom altijd een eigen kopie van je originele documenten. Een veiliger voorstel (alleen ingelogde eigenaar) staat in <code>supabase/proposals/</code> en is nog niet uitgevoerd.</div><pre class="code-block">`);
+};
+/* -- 2.10 · Navigatie: aria-current voor schermlezers -- */
+const setPageBase210=setPage;
+setPage=function(page){setPageBase210(page);try{$$('[data-page]').forEach(b=>{if(b.classList.contains('active'))b.setAttribute('aria-current','page');else b.removeAttribute('aria-current')})}catch{}};
+/* -- 2.10 · Klikacties: instellingen valideren, sync-basis wissen bij ingrijpende lokale acties -- */
+const handleClickBase210=handleClick;
+handleClick=function(e){
+  const b=e.target&&e.target.closest?e.target.closest('button'):null;if(!b)return handleClickBase210(e);
+  if(b.hasAttribute('data-save-settings')){
+    if(!saveAiSettingsCheck())return;
+    state.ai.model=($('#setAiModel')?.value||'').trim();
+    return handleClickBase210(e);
+  }
+  if(b.hasAttribute('data-reset')||b.hasAttribute('data-archive-season')){
+    const before=JSON.stringify(state);const r=handleClickBase210(e);
+    if(JSON.stringify(state)!==before)clearSyncBase();
+    return r;
+  }
+  return handleClickBase210(e);
+};
 /* @@2.10-SECTIONS@@ */
