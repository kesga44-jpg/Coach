+/* -- 2.10 · Sync: basisversie bijhouden (geen valse conflicten bij automatische sync) --
+   Tot 2.9.1 gaf elke lokale wijziging na een sync bij de stille autosync een "conflict", omdat lokaal en cloud
+   dan altijd verschillen. Nu onthoudt dit apparaat welke cloudversie (updated_at) het laatst gelijk was aan
+   lokaal. Is de cloud sindsdien NIET gewijzigd, dan is uploaden een veilige "fast-forward". Is de cloud wel
+   gewijzigd (ander apparaat), dan blijft het bestaande conflictgedrag ongewijzigd.
+   Extra veiligheid: geen stille upload als lokaal opvallend minder gegevens heeft dan de cloud, en na herstel,
+   terugzetten naar startdata of seizoen archiveren is altijd eerst een handmatige bevestiging nodig. */
+const SYNC_BASE_KEY='footballCoachSyncBaseV1';
+let syncSeen=null;
+function readSyncBase(){try{const b=JSON.parse(localStorage.getItem(SYNC_BASE_KEY)||'null');return b&&UUID_RE.test(b.userId||'')&&Number.isFinite(Date.parse(b.updatedAt))?b:null}catch{return null}}
+function writeSyncBase(userId,updatedAt){try{if(UUID_RE.test(userId||'')&&Number.isFinite(Date.parse(updatedAt)))localStorage.setItem(SYNC_BASE_KEY,JSON.stringify({userId,updatedAt,at:new Date().toISOString()}))}catch{}}
+function clearSyncBase(){syncSeen=null;try{localStorage.removeItem(SYNC_BASE_KEY)}catch{}}
+function sameInstant(a,b){const x=Date.parse(a),y=Date.parse(b);return Number.isFinite(x)&&Number.isFinite(y)&&x===y}
+function syncShrinkWarning(cloudData,local){
+  const keys=['players','trainings','matches','exercises'],out=[];
+  keys.forEach(k=>{const c=Array.isArray(cloudData?.[k])?cloudData[k].length:0,l=Array.isArray(local?.[k])?local[k].length:0;if(c-l>=3&&l<c*0.8)out.push(`${k}: ${c} → ${l}`)});
+  return out;
+}
+function syncCanFastForward(cloud,session,local){
+  const base=readSyncBase();
+  if(!cloud||!base||base.userId!==session.user.id||!sameInstant(base.updatedAt,cloud.updatedAt))return false;
+  return !syncShrinkWarning(cloud.data,local).length;
+}
+const fetchCloudCopyBase210=fetchCloudCopy;
+fetchCloudCopy=async function(s,session){const c=await fetchCloudCopyBase210(s,session);syncSeen={userId:session.user.id,updatedAt:c?c.updatedAt:null};return c};
+const approveSyncUserBase210=approveSyncUser;
+approveSyncUser=function(userId){approveSyncUserBase210(userId);if(syncSeen&&syncSeen.userId===userId&&syncSeen.updatedAt)writeSyncBase(userId,syncSeen.updatedAt)};
+writeCloudCopy=async function(s,session,local,cloud){
+  const uid=session.user.id,payload=await encryptData(local,s.pass);
+  let r,sentAt;
+  if(cloud){
+    const expected=Date.parse(cloud.updatedAt);
+    if(!Number.isFinite(expected))throw new SyncError('Cloudkopie mist geldige wijzigingsmetadata; upload afgebroken','server');
+    sentAt=new Date(Math.max(Date.now(),expected+1)).toISOString();
+    r=await syncFetch(tableUrl('?user_id=eq.'+encodeURIComponent(uid)+'&id=eq.'+encodeURIComponent(SYNC_ROW_ID)+'&updated_at=eq.'+encodeURIComponent(cloud.updatedAt)),{method:'PATCH',headers:tableHeaders(s,session,{'Content-Type':'application/json',Prefer:'return=representation'}),body:JSON.stringify({payload,updated_at:sentAt})});
+  }else{
+    sentAt=new Date().toISOString();
+    r=await syncFetch(tableUrl(),{method:'POST',headers:tableHeaders(s,session,{'Content-Type':'application/json',Prefer:'return=representation'}),body:JSON.stringify([{user_id:uid,id:SYNC_ROW_ID,payload,updated_at:sentAt}])});
+  }
+  if(r.ok){
+    const rows=await r.json();
+    if(Array.isArray(rows)&&rows.length){
+      const written=rows[0]&&Number.isFinite(Date.parse(rows[0].updated_at))?rows[0].updated_at:sentAt;
+      syncSeen={userId:uid,updatedAt:written};writeSyncBase(uid,written);
+      return true;
+    }
+  }
+  else if(r.status!==409)throw await tableError(r);
+  const latest=await fetchCloudCopy(s,session);
+  if(latest)preserveCloudConflict(latest);
+  syncStatus('Syncconflict: clouddata is intussen gewijzigd of bestaat al. De nieuwste cloudversie is behouden; controleer beide versies.');
+  return false;
+};
+pushSync=async function(silent=false){
+  const s=getSync();if(!syncConfigured()||syncInFlight||storageLoadError)return;
+  syncInFlight=true;
+  try{
+    const session=await ensureSession(),local=normalizedStateCopy(state),cloud=await fetchCloudCopy(s,session);
+    if(cloud&&JSON.stringify(normalizedStateCopy(cloud.data))!==JSON.stringify(local)&&!syncCanFastForward(cloud,session,local)){
+      if(!preserveCloudConflict(cloud)){syncStatus('Syncconflict: cloudversie kon niet lokaal worden bewaard; cloud is niet overschreven.');return}
+      const shrink=syncShrinkWarning(cloud.data,local);
+      if(silent){syncStatus(shrink.length?`Upload wacht op bevestiging: lokaal staan minder gegevens dan in de cloud (${shrink.join(', ')}). Cloudversie is bewaard; kies Download of bevestig handmatig Upload.`:'Syncconflict: lokale en cloudgegevens verschillen. Cloudversie is bewaard; kies Download of bevestig handmatig Upload.');return}
+      if(!confirm('De lokale en cloudgegevens verschillen'+(shrink.length?` (lokaal minder gegevens: ${shrink.join(', ')})`:'')+'. De cloudversie wordt eerst lokaal bewaard. Wil je de cloudversie vervangen door deze lokale versie?')){syncStatus('Syncconflict: beide versies behouden; geen gegevens overschreven.');return}
+    }
+    if(!cloud&&approvedSyncUser()!==session.user.id){
+      if(silent){syncStatus('Upload wacht op bevestiging: dit account heeft nog geen cloudgegevens. Kies Upload nu om lokale gegevens naar '+(session.user.email||session.user.id)+' te uploaden.');return}
+      if(!confirm('Je lokale gegevens worden voor het eerst geüpload naar het account '+(session.user.email||session.user.id)+'. Dit account heeft nog geen cloudgegevens. Doorgaan?')){syncStatus('Upload geannuleerd; er is niets geüpload en lokale gegevens zijn ongewijzigd.');return}
+    }
+    syncStatus('Versleutelen en veilig synchroniseren…');
+    if(!await writeCloudCopy(s,session,local,cloud)){if(!silent)toast('Syncconflict; de nieuwere cloudversie is behouden');return}
+    approveSyncUser(session.user.id);
+    syncStatus('Gesynchroniseerd · '+new Date().toLocaleTimeString('nl-NL',{hour:'2-digit',minute:'2-digit'}));if(!silent)toast('Sync geüpload');
+  }catch(e){syncStatus((e.code==='auth'?'Sessie: ':'Syncfout: ')+e.message);if(!silent)toast(e.code==='auth'?'Niet ingelogd of sessie verlopen':'Sync mislukt');if(e.code==='auth')renderAuthState()}
+  finally{syncInFlight=false}
+};
