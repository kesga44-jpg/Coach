# Coach heeft GEEN omgevingsvariabelen nodig om te draaien: het is een statische app zonder buildstap.
# De Supabase-projecturl en de PUBLISHABLE key staan bewust bovenin app.js (SYNC_PROJECT_URL, SYNC_PUBLIC_KEY);
# een publishable key is bedoeld voor browsercode en is geen geheim. Zet hier NOOIT een service_role/secret key.
#
# Alleen voor optionele lokale hulpscripts:
# Poort voor de tijdelijke PostgreSQL-testcluster (npm run test:db)
PGPORT_TEST=54329
# Map met PostgreSQL-binaries als die niet automatisch gevonden wordt
# PGBIN=/usr/lib/postgresql/16/bin
# Poort voor de lokale webserver van de Chromium-test (npm run test:e2e)
E2E_PORT=8765
